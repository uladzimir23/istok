# Build-context hygiene: в образ нужны apps/{web,admin} + content/ + packages/
# + infra/nginx/. Корень репо тяжёлый (docs-волт, сырьё клиента) — режем агрессивно,
# чтобы tar build-контекста был лёгким и dev-мусор не утёк в образ.

# Зависимости и build-выводы (ставятся/генерятся внутри образа)
**/node_modules
apps/web/.next
apps/web/out
apps/admin/dist
.next
out

# PocketBase: данные и локальный бинарь — не нужны ни одному образу
# (site/admin делят этот контекст; PB-образ собирается из apps/pocketbase/).
apps/pocketbase/pb_data
apps/pocketbase/pocketbase
apps/pocketbase/pb.zip

# VCS / CI / редакторы / приватка
.git
.github
.claude
.claude-code
.vault-private

# Docs-волт, песочница, корневые скрипты — не нужны для сборки сайта
docs
sandbox
/scripts

# Сырые исходники клиента (большие; и так в .gitignore). Якорим к корню,
# чтобы не зацепить web/public/** и content/**.
/Мебель
/Фотографии кроваток 2
/Компания Исток - Вектор.svg
/tilda-old

# env / логи / ОС-мусор
**/.env
**/.env.*
*.log
.DS_Store

README.md
CLAUDE.md
